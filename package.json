{
  "name": "kore-id",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "init-clients": "node scripts/init-clients.ts",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit",
    "install:web": "npm --prefix web ci",
    "build:web": "npm --prefix web run build",
    "dev:web": "npm --prefix web run dev",
    "test:web": "npm --prefix web test",
    "typecheck:web": "npm --prefix web run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "jose": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
